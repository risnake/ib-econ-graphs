---
import Base from '~/layouts/Base.astro';
import { href } from '~/lib/paths';
---
<Base title="Page not found · Econ Graph Studio">
  <main class="flex min-h-dvh flex-col items-center justify-center px-6 text-center">
    <svg viewBox="0 0 120 90" class="mb-6 h-24 w-32" aria-hidden="true">
      <path d="M14 8v70h96" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-muted"></path>
      <path d="M22 20l78 50" stroke="#2a78d6" stroke-width="3" stroke-linecap="round"></path>
      <path d="M22 64c20-4 34-10 46-30" fill="none" stroke="#eb6834" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 6"></path>
    </svg>
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">This page is off the curve</h1>
    <p class="mt-3 max-w-md text-sm leading-6 text-muted">
      The diagram or page you were looking for doesn’t exist — it may have been renamed.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={href('')} class="inline-flex h-10 items-center rounded-xl border border-line bg-surface px-4 text-sm font-semibold hover:border-line-strong">Browse diagrams</a>
      <a href={href('studio/')} class="inline-flex h-10 items-center rounded-xl bg-accent px-4 text-sm font-semibold text-accent-ink hover:bg-accent-hover">Open studio</a>
    </div>
  </main>
</Base>
