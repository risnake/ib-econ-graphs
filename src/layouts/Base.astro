---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Full-height app layout (no page scroll). */
  app?: boolean;
}
const { title, description = 'Draw every IB Economics diagram — exam-ready, editable, and exportable as PNG, SVG or PDF.', app = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />
    <!-- For AI agents and developers: a public API for creating these diagrams. -->
    <link rel="alternate" type="text/markdown" href={`${base.replace(/\/$/, '')}/llms.txt`} title="Guide for AI agents (llms.txt)" />
    <link rel="service-desc" type="application/openapi+json" href={`${base.replace(/\/$/, '')}/openapi.json`} title="Econ Graph Studio API" />
    <link rel="service-doc" type="text/html" href={`${base.replace(/\/$/, '')}/docs/api/`} title="API documentation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      try {
        const t = localStorage.getItem('ibeg:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class={app ? 'h-dvh overflow-hidden' : 'min-h-dvh'}>
    <slot />
  </body>
</html>
