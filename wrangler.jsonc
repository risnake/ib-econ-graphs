// Cloudflare Workers config: static site + a small Worker for the public API.
// Astro builds the site into ./dist; the Worker (worker/index.ts) only runs for
// the paths in `run_worker_first` — everything else is served as static assets.
// The Worker name in the Cloudflare dashboard must match `name` below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ib-econ-graphs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  // Build the site before every `wrangler deploy` / `wrangler dev`, so a
  // deploy works even if no Build command is set in the Cloudflare dashboard.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // API + machine-readable docs go to the Worker; the rest is static.
    "run_worker_first": ["/api/*", "/api", "/llms.txt", "/llms-full.txt", "/openapi.json", "/skill/*"],
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /graph/tariff → /graph/tariff/ (Astro emits folder/index.html pages).
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
